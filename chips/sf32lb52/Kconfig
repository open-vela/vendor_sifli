if ARCH_CHIP_CUSTOM

comment "SIFLI Configuration Options"

choice
    prompt "SIFLI Chip Selection"
    default ARCH_CHIP_SF32LB52

config ARCH_CHIP_SF32LB52
	bool "sf32lb52"
	select ARCH_CORTEXM4
	select ARCH_HAVE_MPU
	select ARM_HAVE_MPU_UNIFIED
	select ARCH_HAVE_FPU

endchoice

endif
