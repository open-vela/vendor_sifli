/* System init script for NSH ROMFS */

#include <nuttx/config.h>

#ifdef CONFIG_FS_TMPFS
mount -t tmpfs /tmpfs
#endif

#ifdef CONFIG_FS_PROCFS
mount -t procfs /proc
#endif

#if defined(CONFIG_FS_LITTLEFS) && defined(CONFIG_MTD)
/* Mount persistent config/data partition at boot. */

mount -t littlefs /dev/config0 /data
#endif
