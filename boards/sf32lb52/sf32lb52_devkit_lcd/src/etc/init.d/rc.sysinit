/****************************************************************************
 * System init script for NSH ROMFS
 ****************************************************************************/

#include <nuttx/config.h>

#ifdef CONFIG_FS_TMPFS
mkdir /tmpfs
mount -t tmpfs /tmpfs
#endif

#ifdef CONFIG_FS_PROCFS
mkdir /proc
mount -t procfs /proc
#endif

#if defined(CONFIG_FS_LITTLEFS) && defined(CONFIG_MTD) && !defined(CONFIG_FS_TMPFS)
mkdir /data
mount -t littlefs /dev/config0 /data
#endif
